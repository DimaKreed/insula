# Copy to .env.local and fill in what the current phase needs.
# Phase 0 (TTS bake-off) needs only ONE of the TTS provider blocks below.

# --- Database (Neon) --- Phase 1
DATABASE_URL=

# --- Auth.js --- Phase 1
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic-link email + transactional email
RESEND_API_KEY=
# Verified sender for magic-link email, e.g. "Insula <login@yourdomain.com>"
AUTH_EMAIL_FROM=

# --- Translation --- Phase 1
# Which provider translates EN->RO: gemini | claude   (default: gemini)
TRANSLATION_PROVIDER=gemini
# Gemini free tier — https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=
# Optional: override the default free-tier Flash model (gemini-3.5-flash).
# List what your key can use: GET https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=
# Only needed when TRANSLATION_PROVIDER=claude
ANTHROPIC_API_KEY=

# --- TTS --- Phase 0 (bake-off) / Phase 2 (pipeline)
# Which provider the app synthesizes with: elevenlabs | google | azure | openai
TTS_PROVIDER=
# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Google Cloud TTS — service-account JSON, base64-encoded:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("sa.json"))
GOOGLE_TTS_CREDENTIALS=
# Azure AI Speech — key + region slug (e.g. westeurope)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# OpenAI TTS
OPENAI_API_KEY=

# --- Object storage (Cloudflare R2) --- Phase 2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Background jobs (Upstash QStash) --- Phase 2
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Rate limiting (Upstash Redis) --- Phase 7
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
